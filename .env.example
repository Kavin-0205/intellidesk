# IntelliDesk Environment Configuration Template
# Copy this file to .env and fill in your credentials

# Groq API Key (Sign up at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example Local: mongodb://localhost:27017/
# Example Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=intellidesk
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=intellidesk
